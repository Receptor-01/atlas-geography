{
  "name": "atlas",
  "version": "1.0.0",
  "private": true,
  "description": "A tactical world flags and capitals mastery trainer.",
  "author": "Andre",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Receptor-01/atlas-geography.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check app.js && npm audit --omit=dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable",
    "build:web": "node scripts/build-web.mjs",
    "preview:web": "wrangler dev",
    "deploy:web": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.6",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "city-timezones": "^1.3.4",
    "country-json": "^2.3.0",
    "d3": "^7.9.0",
    "d3-geo": "^3.1.1",
    "flag-icons": "^7.5.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "wrangler": "^4.133.0"
  },
  "build": {
    "appId": "com.atlas.geography",
    "productName": "Atlas",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "app.js",
      "index.html",
      "main.js",
      "preload.js",
      "styles.css",
      "refinements.css",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/atlas-command.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
